<?xml version="1.0" encoding="utf-8"?>
<!--
  หน้าจอแจ้งเตือนงานใหม่ — ตามแบบที่ user ออกแบบด้วย Claude Design (31/08/69)

  ภาษาภาพ: ขอบเหลี่ยมทั้งหมด ไม่มีมุมโค้ง · เส้นคั่นหนา 2dp · ตัวหนังสือใหญ่
  ⛔ ไม่ระบุ fontFamily โดยตั้งใจ — user เลือกใช้ฟอนต์ไทยของเครื่อง (ไม่ฝังฟอนต์เพิ่มใน APK)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F2F2">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── หัวจอ: ปิดเสียง + นับถอยหลัง ─────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp">

            <!-- ไอคอนกระดิ่งของเราเอง (ic_bell / ic_bell_off) — ไอคอนระบบหน้าตาเพี้ยนตามยี่ห้อเครื่อง
                 marginStart 0: -6dp ทำให้ปุ่มโดนขอบจอตัด บนเครื่องที่ขอบจอโค้ง -->
            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bell"
                android:scaleType="fitCenter"
                android:contentDescription="ปิดเสียงแจ้งเตือน" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="แจ้งเตือนงาน"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#7D7979" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/dot_live"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="#008A3E" />

            <TextView
                android:id="@+id/txt_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#006A29" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#26BAB6B6" />

        <!-- ── เนื้อหา ──────────────────────────────────────────────── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="งานสำรวจใหม่"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="#201E1D" />

                <!-- บริษัทประกัน — คั่นบน/ล่างด้วยเส้นหนา -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="20dp"
                    android:background="#66201E1D" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:id="@+id/img_logo"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="โลโก้บริษัทประกัน"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_insurance_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#201E1D" />

                        <TextView
                            android:id="@+id/txt_insurance_en"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="12sp"
                            android:letterSpacing="0.04"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#7D7979"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#66201E1D" />

                <!-- เลขเคลม -->
                <LinearLayout
                    android:id="@+id/row_claim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="เลขเคลม"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="#7D7979" />

                    <TextView
                        android:id="@+id/txt_claim_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:textColor="#201E1D" />
                </LinearLayout>

                <!-- สถานที่เกิดเหตุ -->
                <View
                    android:id="@+id/div_incident"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#D7D3D3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="สถานที่เกิดเหตุ"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="#7D7979" />

                    <TextView
                        android:id="@+id/txt_incident"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="18sp"
                        android:lineSpacingMultiplier="1.45"
                        android:textColor="#201E1D" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ── ปุ่มล่าง ─────────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#26BAB6B6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- ปฏิเสธ = ปุ่มรอง ตัวหนังสือล้วน ชิดซ้าย · กันนิ้วไปโดนโดยบังเอิญตอนหยิบเครื่อง -->
            <TextView
                android:id="@+id/btn_decline"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="12dp"
                android:text="ปฏิเสธงาน"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#7D7979"
                android:background="?android:attr/selectableItemBackground" />

            <LinearLayout
                android:id="@+id/btn_accept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_accept_green"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="รับงาน"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── แผ่นเลือกเหตุผลปฏิเสธ (ทับอยู่บนหน้าเดิม) ──────────────── -->
    <LinearLayout
        android:id="@+id/decline_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:background="#8C201E1D"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sheet_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F3F2F2"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="18dp"
                android:background="#201E1D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="เหตุผลที่ปฏิเสธงาน"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#201E1D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="เลือก 1 ข้อ เพื่อยืนยันการปฏิเสธ"
                android:textSize="13.5sp"
                android:textColor="#7D7979" />

            <LinearLayout
                android:id="@+id/reason_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/btn_confirm_decline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/btn_confirm_red"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="ยืนยันปฏิเสธ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:alpha="0.45" />

                <TextView
                    android:id="@+id/btn_cancel_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:background="@drawable/border_dark_2dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="ยกเลิก"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#201E1D" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <!-- ── หน้าสรุปหลังกดรับงาน ─────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/accepted_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:background="#008A3E"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_accepted_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="รับงานแล้ว"
            android:textSize="40sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="กำลังเปิดรายละเอียดงาน…"
            android:textSize="16sp"
            android:alpha="0.9"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- ── หน้าสรุปหลังปฏิเสธงาน ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/declined_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EC3013"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/declined_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="bottom"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

        <TextView
            android:id="@+id/txt_declined_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ปฏิเสธงานแล้ว"
            android:textSize="40sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txt_declined_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:alpha="0.9"
            android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── หน้าสรุปเมื่องานถูกถอน (ย้าย/ถอน/ลบจากเว็บ — 22/09/69) ───────── -->
    <LinearLayout
        android:id="@+id/withdrawn_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:background="#37474F"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_withdrawn_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="งานถูกถอนแล้ว"
            android:textSize="40sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txt_withdrawn_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:alpha="0.9"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
